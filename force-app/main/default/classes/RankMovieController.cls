public with sharing class RankMovieController {

    public class MovieCardResult {
        @AuraEnabled public Id movieId;
        @AuraEnabled public Decimal score;
        @AuraEnabled public String recommendation;
        @AuraEnabled public String reasoning;
        @AuraEnabled public String plotSummary;
        @AuraEnabled public String errorMessage;
    }

    @AuraEnabled
    public static MovieCardResult generateMovieCard(Id movieId) {
        MovieCardResult result = new MovieCardResult();
        result.movieId = movieId;

        try {
            Movie__c movieRecord = [
                SELECT Id, Name, Year__c, Genre__c, Plot_Summary__c, Poster_Link__c
                FROM Movie__c
                WHERE Id = :movieId
                WITH USER_MODE
                LIMIT 1
            ];
            result.plotSummary = movieRecord.Plot_Summary__c;

            // Build the input map for the prompt template. The template's
            // merge field references the Movie__c record, so we wrap the
            // record Id (not the record itself) as a ConnectApi.WrappedValue.
            
            Map<String, String> recordMap = new Map<String, String>();
            recordMap.put('id', movieRecord.Id); 
            Map<String, ConnectApi.WrappedValue> inputParams = new Map<String, ConnectApi.WrappedValue>();
            ConnectApi.WrappedValue movieValue = new ConnectApi.WrappedValue();
            movieValue.value = recordMap;
            inputParams.put('Input:movieRecord', movieValue);

            ConnectApi.EinsteinPromptTemplateGenerationsInput generationsInput =
                new ConnectApi.EinsteinPromptTemplateGenerationsInput();
            // Must be explicitly set: the platform unboxes this without a
            // null check, so omitting it throws a NullPointerException on
            // GenAiPromptTemplateGenerateInfo.getPreviewOnly().
            generationsInput.isPreview = false;
            generationsInput.inputParams = inputParams;
            generationsInput.additionalConfig = new ConnectApi.EinsteinLlmAdditionalConfigInput();
            generationsInput.additionalConfig.applicationName = 'PromptTemplateGenerationsInvocable';

            // Call the scoring template directly rather than the card-HTML
            // template. Scoring_Synthesizer returns a strict, parseable
            // three-line format ("Score:" / "Reasoning:" / "Recommendation:")
            // instead of free-form HTML, so the card layout below is built
            // deterministically in the LWC rather than by the LLM.
            ConnectApi.EinsteinPromptTemplateGenerationsRepresentation generationsOutput =
                ConnectApi.EinsteinLLM.generateMessagesForPromptTemplate(
                    'Scoring_Synthesizer',
                    generationsInput
                );

            if (generationsOutput != null
                && generationsOutput.generations != null
                && !generationsOutput.generations.isEmpty()) {
                String text = generationsOutput.generations[0].text;
                result.score = parseScore(text);
                result.recommendation = parseRecommendation(text);
                result.reasoning = parseReasoning(text);
                if (result.score == null || String.isBlank(result.recommendation)) {
                    result.errorMessage = 'Unable to parse a score/recommendation from the response.';
                }
            } else {
                result.errorMessage = 'No response was generated by the prompt template.';
            }
        } catch (Exception e) {
            result.errorMessage = e.getMessage();
        }

        return result;
    }

    /**
     * Parses the Scoring_Synthesizer response, which is instructed to
     * return EXACTLY three lines:
     *   Score: <number 1-10>
     *   Reasoning: <2 sentences>
     *   Recommendation: <GO|BACKUP|SKIP>
     * Parsing plain, structured text (instead of LLM-generated HTML)
     * is what makes the resulting card deterministic — the LLM only
     * supplies the score/reasoning/recommendation values, and the LWC
     * is solely responsible for rendering them consistently.
     */
    private static Decimal parseScore(String text) {
        if (String.isBlank(text)) {
            return null;
        }
        Pattern p = Pattern.compile('(?im)^\\s*Score:\\s*(\\d+(\\.\\d+)?)');
        Matcher m = p.matcher(text);
        if (m.find()) {
            return Decimal.valueOf(m.group(1));
        }
        return null;
    }

    private static String parseRecommendation(String text) {
        if (String.isBlank(text)) {
            return null;
        }
        Pattern p = Pattern.compile('(?im)^\\s*Recommendation:\\s*(GO|BACKUP|SKIP)\\b');
        Matcher m = p.matcher(text);
        if (m.find()) {
            return m.group(1).toUpperCase();
        }
        return null;
    }

    private static String parseReasoning(String text) {
        if (String.isBlank(text)) {
            return null;
        }
        Pattern p = Pattern.compile('(?ims)^\\s*Reasoning:\\s*(.*?)\\s*(?=^\\s*Recommendation:|\\z)');
        Matcher m = p.matcher(text);
        if (m.find()) {
            return m.group(1).trim();
        }
        return null;
    }
}